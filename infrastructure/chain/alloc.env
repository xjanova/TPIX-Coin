# ══════════════════════════════════════════════════════════════════════════════
#  TPIX Genesis Allocation — แหล่งความจริงเพียงแหล่งเดียว (single source of truth)
# ══════════════════════════════════════════════════════════════════════════════
#
#  ⛔ อย่าไปแก้ตารางจัดสรรที่อื่นอีก ให้แก้ที่ไฟล์นี้ที่เดียว
#
#  เหตุผลที่ไฟล์นี้ต้องมี — ใน repo เคยมีตารางจัดสรร "สองชุดที่ขัดกัน":
#    ชุด A (ใช้จริง / คุมคีย์ได้)  = ไฟล์นี้ — BIP-44 HD wallet ที่สร้าง 2026-05-04
#    ชุด B (เก่า / คีย์หาย!)      = ที่ฝังอยู่ใน chain-regenesis-4v.yml และ
#                                   chain-reset-fixed.yml เช่น
#                                   0x3F8EB4046F5C79fd0D67C7547B5830cB2Cfb401A
#                                   ← 700M TPIX ที่ไม่มีใครมี private key
#  ถ้าเผลอรัน yml สองไฟล์นั้น = เผา 700M TPIX ทิ้งซ้ำรอบสอง
#  → ทั้งสองไฟล์ถูก mark เป็น DEAD แล้ว ดู docs/REGENESIS-RUNBOOK.md
#
#  รูปแบบ:  ALLOC_<slug>="<address>:<จำนวน TPIX เต็มหน่วย ไม่ใช่ wei>"
#  สคริปต์ build-genesis.sh จะคูณ 10^18 ให้เอง
#
#  ยอดรวม 6 กระเป๋านี้ = 6,960,000,000 TPIX
#  + validator 4 ตัว × 10,000,000 = 40,000,000 TPIX (สคริปต์เติมให้อัตโนมัติ)
#  ─────────────────────────────────────────────
#  รวมทั้งสิ้น = 7,000,000,000 TPIX  ตรง WHITEPAPER §6
#
#  ⚠️ ก่อนรัน regenesis: เปิด docs/WHITEPAPER.md §6 แล้วเทียบทีละบรรทัดด้วยตา
#     และยืนยันว่า "ปลดล็อกกระเป๋าทั้ง 6 ได้จริง" จาก keystore/mnemonic ที่สำรองไว้
#     (ทดสอบ decrypt จริง 1 ครั้ง — อย่าเชื่อว่าไฟล์ backup ใช้ได้โดยไม่เคยลอง)
# ══════════════════════════════════════════════════════════════════════════════

# 20% — Master Node Rewards
ALLOC_MASTERNODE_REWARDS="0xf54c0deE404ec728a03b467cba7bBA171CC77dad:1400000000"

# 24.43% — Community / Ecosystem
ALLOC_COMMUNITY="0x6E176Bf5Aa39Fb4217E0ebd00E14B67aDfFaf440:1710000000"

# 10% — Development
ALLOC_DEVELOPMENT="0x87e62D9e0C2aF15d634D3301Dd2D4DA57972052d:700000000"

# 10% — Token Sale (ต้นทางของ bonding curve — BIP-44 path m/44'/60'/0'/0/4)
ALLOC_TOKEN_SALE="0x4BcC1844Ad9E8587f7005f092928a5D14C30F463:700000000"

# 15% — Liquidity (จะกลายเป็น LP หลัง bonding curve migrate)
ALLOC_LIQUIDITY="0x2644A740A06e0401D21F8B4A840400fFe8dB42A9:1050000000"

# 20% — Team & Founders
ALLOC_TEAM="0x6dECa2E185CF37e7c838fE5Ae6897aED025c9921:1400000000"

# ── ค่าคงที่ของเชน (build-genesis.sh อ่านไปใช้) ───────────────────────────────
CHAIN_ID=4289
CHAIN_NAME="tpix-chain"
TOTAL_SUPPLY=7000000000
VALIDATOR_COUNT=4
VALIDATOR_PREMINE=10000000          # TPIX ต่อ validator หนึ่งตัว (ค่าแก๊สใช้งาน)
BLOCK_TIME="2s"                     # อย่าเกิน 2s ถ้า validator ยังอยู่ภูมิภาคเดียวกัน
EPOCH_SIZE=100000
BLOCK_GAS_LIMIT=20000000
POLYGON_EDGE_IMAGE="0xpolygon/polygon-edge:0.9.0"
